---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Small, cozy things, slowly growing.' } = Astro.props;

// Only show nav items whose page exists.
const existing = Object.keys(import.meta.glob('/src/pages/*.astro')).map((p) => p.split('/').pop()!.replace('.astro', ''));
const nav = [
  { slug: 'index', label: 'Home', href: '/' },
  { slug: 'writing', label: 'Writing' },
  { slug: 'projects', label: 'Projects' },
  { slug: 'stack', label: 'Stack' },
  { slug: 'about', label: 'About' },
].filter((n) => existing.includes(n.slug));
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · haphan</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (function () {
        try {
          var t = null;
          try { t = localStorage.getItem("theme"); } catch (e) {}
          if (t !== "light" && t !== "dark") t = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {}
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="https://haphan.digital" rel="noopener" title="haphan.digital"><span class="sprout" aria-hidden="true">🌱</span> haphan</a>
      <div class="header-right">
        <nav aria-label="Main">
          {nav.map((n) => (
            <a href={n.href ?? `/${n.slug}/`} aria-current={(n.href ? path === n.href : path.startsWith(`/${n.slug}`)) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
        <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Switch between light and dark mode" title="Light / dark mode">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.4M12 19.1v2.4M2.5 12h2.4M19.1 12h2.4M5.3 5.3l1.7 1.7M17 17l1.7 1.7M5.3 18.7L7 17M17 7l1.7-1.7"/></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.2A8.5 8.5 0 1 1 9.8 3.5a6.8 6.8 0 0 0 10.7 10.7z"/></svg>
        </button>
      </div>
    </header>
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("theme-toggle");
        function current() {
          var t = root.getAttribute("data-theme");
          if (t) return t;
          return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        btn.addEventListener("click", function () {
          var next = current() === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          try { localStorage.setItem("theme", next); } catch (e) {}
        });
      })();
    </script>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>Sprout in the server room · built with Astro · slowly growing 🌿</span>
    </footer>
  </body>
</html>
