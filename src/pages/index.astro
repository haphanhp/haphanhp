---
import Base from '../layouts/Base.astro';

// Linktree-style home. Every link is a real URL supplied by the owner.
const explore = [
  { icon: '🎮', title: 'Projects', sub: 'What I am building and playing with', href: '/projects/' },
  { icon: '🧰', title: 'Stack', sub: 'The tools I use, and how they fit together', href: '/stack/' },
  { icon: '🌐', title: 'haphan.digital', sub: 'My main website', href: 'https://haphan.digital', external: true },
  { logo: '/logos/github.svg', title: 'GitHub', sub: 'haphanhp', href: 'https://github.com/haphanhp', external: true },
];
const proof = [
  { icon: '❤️', title: 'Testimonials', sub: 'senja.io', href: 'https://senja.io/p/haphan/WPMu8HK', external: true },
];
const sayHi = [
  { logo: '/logos/whatsapp.svg', title: 'WhatsApp', sub: 'Say hi', href: 'https://api.whatsapp.com/send?phone=84979433762&text=I%20saw%20your%20WhatsApp%20number%20and%20I%20would%20like%20to%20connect', external: true },
];
const support = [
  { logo: '/logos/kofi.svg', title: 'Ko-fi', sub: 'ko-fi.com/haphanhp', href: 'https://ko-fi.com/haphanhp', external: true },
  { logo: '/logos/paypal.svg', title: 'PayPal', sub: 'paypal.me/haphanvn', href: 'https://www.paypal.com/paypalme/haphanvn', external: true },
];
// Order: my work first, then proof, then contact, then support last.
const sections = [
  { title: 'Explore', links: explore },
  { title: '', links: proof },
  { title: 'Say hi', links: sayHi },
  { title: 'Support', links: support },
];
---
<Base title="Home" description="Small, cozy things, slowly growing.">
  <div class="home">
    <img class="avatar" src="https://github.com/haphanhp.png?size=224" alt="haphanhp on GitHub" width="112" height="112" />
    <h1>haphan</h1>
    <div class="bio">
      <p>🌱 A stray soul in a dry, code-heavy world, wandering into tech by accident and staying for the plants.</p>
      <p>🎮 I build small, cozy things, just playing in the sandbox like a curious outsider with fresh eyes.</p>
      <p>🌿 Soft, stubborn, and slowly growing.</p>
      <p>✨ Innocence: uninstalled. Curiosity: still running.</p>
    </div>
    {sections.map((sec) => (
      <section class="link-section">
        {sec.title && <h2>{sec.title}</h2>}
        <ul class="links">
          {sec.links.map((l) => (
            <li>
              <a class="link-btn" href={l.href} {...(l.external ? { target: '_blank', rel: 'noopener' } : {})}>
                <span class="lb-icon" aria-hidden="true">{l.logo ? <img src={l.logo} alt="" /> : l.icon}</span>
                <span>{l.title}<small>{l.sub}</small></span>
                <span class="arrow" aria-hidden="true">{l.external ? '↗' : '→'}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
